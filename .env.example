# docker compose 变量示例：复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
#   cp .env.example .env

# 宿主机映射端口
GROK_REGISTER_PORT=5000

# 端口发布到哪个网卡。公网服务器建议改成 127.0.0.1，再用 SSH 隧道或反代访问
GROK_REGISTER_BIND=0.0.0.0

# 固定 Flask session 密钥，避免重启后会话失效（开了管理口令后尤其要设）
#   openssl rand -hex 32
GROK_REGISTER_SECRET_KEY=

# 走 HTTPS 反代时改成 true，让 session cookie 带 Secure 标志。
# 明文 HTTP 下设为 true 会导致 cookie 发不回来，永远登不上。
GROK_REGISTER_COOKIE_SECURE=false

# 管理口令不在这里配。哈希里带 $，写进 .env 会被 compose 插值吃掉盐值且不报错。
# 用文件方式生成（compose 里已指向 /app/data/admin_password.hash）：
#   docker compose run --rm grok-register-web python scripts/hash_password.py

# 容器时区，影响日志与数据库时间戳
TZ=Asia/Shanghai

# 构建时是否安装 Camoufox 本地 Turnstile Solver（0 可让镜像小约 250MB）
WITH_SOLVER=1
